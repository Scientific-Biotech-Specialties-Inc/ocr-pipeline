APP_NAME=ocr-pipeline
APP_ENV=development
APP_PORT=8010

SERMS_API_KEY=serms-ocr-service-key-change-me
PRS_API_KEY=prs-ocr-service-key-change-me
CALLBACK_API_KEY=ocr-callback-key-change-me

# LLM Provider: Google AI Studio Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=15.0
ENABLE_LLM_ITEM_NORMALIZATION=true
FILE_CACHE_BYTE_TTL=600
FILE_CACHE_RESULT_TTL=7776000

REDIS_URL=redis://ocr_redis:6379/0
MONGODB_URL=mongodb://ocr_mongo:27017
MONGODB_DATABASE=ocr_pipeline

POSTGRES_URL=postgresql+asyncpg://ocr_user:secret@ocr_postgres:5432/ocr_pipeline
POSTGRES_USER=ocr_user
POSTGRES_PASSWORD=secret
POSTGRES_DB=ocr_pipeline

EMBEDDING_MODEL=all-MiniLM-L6-v2
DUPLICATE_SIMILARITY_THRESHOLD=0.85
DUPLICATE_DAYS_WINDOW=90

OCR_LANGUAGE=eng
# Escalated OCR pool tuning (defaults = full pool; shrinking trades accuracy
# for speed on hard receipts - see docs/SDD.md)
OCR_POOL_VARIANTS=all
OCR_POOL_PSMS=6,4,11
CALLBACK_MAX_RETRIES=3
CALLBACK_BACKOFF_SECONDS=10,30,60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_OCR_PER_MINUTE=30
RATE_LIMIT_DUPLICATE_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_HEALTH_PER_MINUTE=60
RATE_LIMIT_AUTH_FAIL_PER_MINUTE=15
